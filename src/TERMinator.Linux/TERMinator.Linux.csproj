<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>TERMinator</AssemblyName>
    <RootNamespace>TERMinator.Linux</RootNamespace>
    <Version>1.1.7</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>
    <InformationalVersion>1.1.7</InformationalVersion>
    <!-- One project, two CPUs (like Rainwire's amd64/arm64): a plain build is the PC (x64) build, exactly as before.
         The 64-bit ARM build (Raspberry Pi 4/5, ARM laptops) is the same source published with -p:Platform=arm64,
         which ../../../TERMinator-ARM/build-arm64.sh does; it picks the arm64 runtime, native library and TRACE host. -->
    <Platforms>x64;arm64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'arm64'">linux-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'arm64'">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- The CRT post-process is an SKSL runtime shader run through Avalonia's Skia backend.
         Avalonia.Skia is already pulled in transitively by Avalonia.Desktop; it is named
         explicitly here because Effects/CrtDrawOperation.cs uses ISkiaSharpApiLeaseFeature
         from it directly, and SkiaSharp for SKRuntimeEffect. -->
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\header_logo.png" />
    <AvaloniaResource Include="Assets\splash_screen.png" />
    <AvaloniaResource Include="Assets\snapshots\*.png" />
    <!-- IBM Model M key clicks, cut from Wikimedia Commons recordings (CC0 / public domain); see KeyClickService -->
    <AvaloniaResource Include="Assets\Sounds\*.wav" />
    <!-- About box music: "Elysium" by Jester of Sanity; see AudioService.PlayAboutMusic -->
    <AvaloniaResource Include="Assets\Music\ELYSIUM.MOD" />
    <AvaloniaResource Include="Themes\RetroTheme.axaml" />
  </ItemGroup>

  <!-- arm64: the native library cross-built by TERMinator-ARM/build-arm64.sh from this repo's native/ -->
  <ItemGroup Condition="'$(Platform)' == 'arm64'">
    <None Include="..\..\..\TERMinator-ARM\build\native\libsyncterm-native.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="libsyncterm-native.so" Condition="Exists('..\..\..\TERMinator-ARM\build\native\libsyncterm-native.so')" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' != 'arm64'">
    <!-- Copy native shared library to output -->
    <None Include="..\..\native\build\Release\libsyncterm-native.so" CopyToOutputDirectory="PreserveNewest" Link="libsyncterm-native.so" Condition="Exists('..\..\native\build\Release\libsyncterm-native.so')" />
    <None Include="..\..\native\build\Debug\libsyncterm-native.so" CopyToOutputDirectory="PreserveNewest" Link="libsyncterm-native.so" Condition="!Exists('..\..\native\build\Release\libsyncterm-native.so') And Exists('..\..\native\build\Debug\libsyncterm-native.so')" />
  </ItemGroup>

  <!-- TRACE (TERMinator Render And Compute Engine): the sandboxed WebAssembly host and Wasmtime, into trace/ beside
       the app (Services/TraceModules.HostPath). Built from the shared source in TERMinator-Windows/trace/ by
       trace/build_gamesandbox.sh into trace/bin-linux-x86_64/. Ship the host and the app together (TRACE records). -->
  <PropertyGroup>
    <TraceHostDir>..\..\..\TERMinator-Windows\trace\bin-linux-x86_64\</TraceHostDir>
    <TraceHostDir Condition="'$(Platform)' == 'arm64'">..\..\..\TERMinator-Windows\trace\bin-linux-aarch64\</TraceHostDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(TraceHostDir)gamesandbox')">
    <None Include="$(TraceHostDir)gamesandbox" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="trace\gamesandbox" />
    <None Include="$(TraceHostDir)libwasmtime.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="trace\libwasmtime.so" />
  </ItemGroup>
  <!-- The GPU for modules (WebGPU): optional. gamesandbox opens it by name at run time, and TraceModules.GpuInstalled
       tells doors gpu=1 only when it is here, so a build without it simply has modules draw on the processor. -->
  <ItemGroup Condition="Exists('$(TraceHostDir)libwgpu_native.so')">
    <None Include="$(TraceHostDir)libwgpu_native.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="trace\libwgpu_native.so" />
  </ItemGroup>

</Project>
